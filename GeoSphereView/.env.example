
# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/environmental_monitoring
SQLALCHEMY_DATABASE_URI=postgresql://username:password@localhost:5432/environmental_monitoring

# For SQLite (development)
# DATABASE_URL=sqlite:///instance/munisat.db
# SQLALCHEMY_DATABASE_URI=sqlite:///instance/munisat.db

# Security (CHANGE THESE IN PRODUCTION)
SECRET_KEY=your-secret-key-here-change-in-production

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Server Configuration
HOST=0.0.0.0
PORT=5000

# ML Model Configuration
MODEL_PATH=models/

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Optional: Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Optional: External API Keys
SENTINEL_API_KEY=your-sentinel-api-key
WEATHER_API_KEY=your-weather-api-key
