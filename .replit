modules = ["nodejs-20", "web", "python-3.12"]
run = "npm run dev"

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[deployment]
run = ["sh", "-c", "npm run dev"]

[workflows]
runButton = "Run Flask App"

[[workflows.workflow]]
name = "Run Flask App"
author = 46415504
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd GeoSphereView && python run_replit.py"

[[ports]]
localPort = 5000
externalPort = 80
