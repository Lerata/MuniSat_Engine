modules = ["nodejs-20", "web", "python-3.12"]
run = "npm run dev"

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[deployment]
run = ["sh", "-c", "npm run dev"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Run Flask App"
author = 46415504
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd GeoSphereView && python run_replit.py"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GeoSphere Flask App"

[[workflows.workflow]]
name = "GeoSphere Flask App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd GeoSphereView && python app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
