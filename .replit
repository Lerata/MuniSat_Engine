modules = ["nodejs-20", "web", "python-3.12"]
run = "npm run dev"

[nix]
channel = "stable-25_05"

[deployment]
run = ["sh", "-c", "npm run dev"]

[workflows]
runButton = "Run Flask App"

[[workflows.workflow]]
name = "Run Flask App"
author = 46415504
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd GeoSphereView && python app.py"
